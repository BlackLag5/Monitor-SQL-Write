# Copy to .env (gitignored) and fill in real values.

# Monitor ERP API
MONITOR_HOST=192.168.1.4
MONITOR_PORT=8001
MONITOR_LANGUAGE_CODE=en
MONITOR_COMPANY_NUMBER=001.1
MONITOR_API_USER=API
MONITOR_API_PASSWORD=change-me
MONITOR_INSECURE_TLS=true

# Companies shown in the UI selector (optional; "number|label" comma separated).
# Defaults to the four known companies.
# MONITOR_COMPANIES=001.1|Production,001_1.1|Daily refresh,001_2.1|Training,001_3.1|Import jobs

# Optional: revenue account id to inject into customer-order row coding when
# Monitor cannot default the account (fixes the "Account required" error).
# MONITOR_SALES_ACCOUNT_ID=

# Login — first admin is seeded from these on first start (if no users exist).
# AUTH_ADMIN_USER=admin
# AUTH_ADMIN_PASSWORD=change-me-please
# AUTH_ADMIN_DISPLAY=Administrator

# This web app
PORT=3002
